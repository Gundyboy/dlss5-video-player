<Application x:Class="NeuralBatch.App" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#232733" />
  <SolidColorBrush x:Key="LineBrush" Color="#3C4352" />
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF0F6" /></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EEF0F6" /><Setter Property="Background" Value="#343B4B" />
   <Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#AFA0FF" /><Setter TargetName="Frame" Property="BorderThickness" Value="1" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#EEF0F6" /><Setter Property="Background" Value="#191D27" />
   <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="Padding" Value="9,7" />
   <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="CaretBrush" Value="White" />
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF0F6" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
 </Application.Resources>
</Application>
