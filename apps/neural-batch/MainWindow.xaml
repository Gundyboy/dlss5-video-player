<Window x:Class="NeuralBatch.MainWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DLSS Neural Batch" Width="1120" Height="840" MinWidth="820" MinHeight="760"
 Background="#171B24" Foreground="#EEF0F6" FontFamily="Segoe UI" FontSize="13"
 AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing" WindowStartupLocation="CenterScreen">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="120" /><RowDefinition Height="Auto" /><RowDefinition Height="100" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <StackPanel><TextBlock Text="DLSS Neural Batch" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Process your images in a queue. Keep your originals." Foreground="#A7B1C4" Margin="0,5,0,0" /></StackPanel>
   <TextBlock Text="v0.1.0" Foreground="#8994AB" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" />
  </Grid>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
   <DockPanel><Button Content="Choose renderer…" DockPanel.Dock="Right" Click="ChooseRenderer" IsEnabled="{Binding CanConfigure}" Margin="12,0,0,0" /><TextBlock Text="{Binding RendererStatus}" VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel>
  </Border>
  <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="Mix" VerticalAlignment="Center" FontWeight="SemiBold" />
    <Grid Grid.Column="1" IsEnabled="{Binding CanConfigure}" Margin="0,0,18,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /><ColumnDefinition Width="25" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
     <Slider Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Mix, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0" />
     <TextBox Grid.Column="1" Text="{Binding Mix, UpdateSourceTrigger=LostFocus}" MaxLength="3" TextAlignment="Right" ToolTip="0% original · 100% neural · 200% enhanced" />
     <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" />
     <StackPanel Grid.Column="3" Margin="22,0,0,0"><CheckBox Content="Pano — protect the 360° wrap seam" IsChecked="{Binding Pano}" /><TextBlock Text="Uses two views for a full-width panorama" FontSize="11" Foreground="#A7B1C4" Margin="19,4,0,0" /></StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="Save to" VerticalAlignment="Center" />
    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" />
    <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="ChooseOutput" IsEnabled="{Binding CanConfigure}" Margin="10,0,0,0" />
   </Grid>
  </Border>
  <DockPanel Grid.Row="3" Margin="0,0,0,10">
   <TextBlock DockPanel.Dock="Right" Text="{Binding Counts}" Foreground="#A7B1C4" VerticalAlignment="Center" Margin="8,0,0,0" />
   <WrapPanel><Button Content="Add images" Click="AddImages" Background="#6756D8" /><Button Content="Add folder" Click="AddFolder" /><Button Content="Remove selected" Click="RemoveSelected" /><Button Content="Retry failed" Click="RetryFailed" IsEnabled="{Binding CanConfigure}" /><Button Content="Clear finished" Click="ClearFinished" /></WrapPanel>
  </DockPanel>
  <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
   <Grid>
    <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
     SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="36" AlternatingRowBackground="#202531"
     Background="#1B202B" Foreground="#EEF0F6" BorderThickness="0" RowBackground="#1B202B" HorizontalScrollBarVisibility="Auto">
     <DataGrid.Resources>
      <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2C3342" /><Setter Property="Foreground" Value="#B9C3D7" /><Setter Property="Padding" Value="12,10" /><Setter Property="BorderThickness" Value="0" /></Style>
      <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="10,0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
      <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="#EEF0F6" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
     </DataGrid.Resources>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Image" Binding="{Binding FileName}" Width="2*" MinWidth="140" />
      <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*" MinWidth="100" />
      <DataGridTextColumn Header="Pixels" Binding="{Binding Size}" Width="105" />
      <DataGridTemplateColumn Header="Status" Width="2*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="Add images or drop files and folders here&#10;PNG · JPG · TIFF · BMP → lossless PNG" Foreground="#8994AB" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Jobs.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </Border>
  <Grid Grid.Row="5" Margin="0,14,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding CurrentStatus}" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" /><ProgressBar Height="5" Background="#303748" Foreground="#8C79EF" IsIndeterminate="{Binding IsRunning}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" /></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Start queue" Click="StartQueue" IsEnabled="{Binding CanStart}" Background="#6756D8" /><Button Content="{Binding PauseText}" Click="PauseQueue" IsEnabled="{Binding IsRunning}" /><Button Content="Stop" Click="StopQueue" IsEnabled="{Binding IsRunning}" Margin="0" /></StackPanel>
  </Grid>
  <TextBox Grid.Row="6" x:Name="ActivityLog" Text="{Binding LogText, Mode=OneWay}" TextChanged="LogChanged" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Background="#1B202B" />
  <DockPanel Grid.Row="7" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Open output folder" Click="OpenOutput" Margin="0" Padding="10,5" /><TextBlock Text="Made by Will" Foreground="#8994AB" FontSize="11" VerticalAlignment="Center" /></DockPanel>
 </Grid>
</Window>
