{
  "manifestVersion": 5,
  "id": "com.reality3d.dlssneuralmix",
  "name": "DLSS Neural Mix",
  "version": "0.2.5",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0" },
  "icons": [
    { "width": 24, "height": 24, "path": "icons/plugin.svg", "theme": ["all"] }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "dlssNeuralMix",
      "label": { "default": "DLSS Neural Mix" },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/plugin.svg", "theme": ["all"] }
      ],
      "minimumSize": { "width": 260, "height": 360 },
      "maximumSize": { "width": 1200, "height": 1600 },
      "preferredDockedSize": { "width": 380, "height": 700 },
      "preferredFloatingSize": { "width": 440, "height": 760 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["http://localhost:47837"] },
    "launchProcess": { "extensions": [".exe"] }
  }
}
