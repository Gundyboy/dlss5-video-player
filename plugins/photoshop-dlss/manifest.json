{
  "manifestVersion": 5,
  "id": "com.reality3d.dlssneuralmix",
  "name": "DLSS Neural Mix",
  "version": "0.2.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0" },
  "icons": [
    { "width": 24, "height": 24, "path": "icons/plugin.svg", "theme": ["all"] }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "dlssNeuralMix",
      "label": { "default": "DLSS Neural Mix" },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/plugin.svg", "theme": ["all"] }
      ],
      "minimumSize": { "width": 220, "height": 260 },
      "preferredDockedSize": { "width": 350, "height": 520 },
      "preferredFloatingSize": { "width": 400, "height": 570 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["http://127.0.0.1:47837"] },
    "launchProcess": { "extensions": [".exe"] }
  }
}
